generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPERADMIN
  SUPPORT
}

enum ShopStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ShopUserRole {
  OWNER
  MANAGER
  CASHIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ShopUserStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

model AdminUser {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      AdminRole @default(SUPERADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Shop {
  id             String     @id @default(uuid())
  name           String
  ownerName      String
  phone          String     @unique
  email          String?
  address        String?
  gstNumber      String?
  currency       String     @default("INR")
  gstEnabled     Boolean    @default(true)
  defaultGstRate Float      @default(5.0)
  upiId          String?
  categories     String[]   @default([])
  logoUrl        String?
  status         ShopStatus @default(TRIAL)
  // Whether this shop has ever started its one-time 14-day Pro trial —
  // checked by trial.service.js's canStartTrial/startTrial before granting
  // another. Deliberately a standalone flag rather than inferred from
  // Subscription history alone: it must stay true forever even though the
  // TRIAL-status Subscription row that caused it is just one row among
  // possibly many later ones (an upgrade to paid Pro, a downgrade back to
  // Basic, etc.) — nothing else here is a reliable "ever had a trial" signal.
  trialUsed      Boolean    @default(false)
  lastDataSyncAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  subscriptions   Subscription[]
  shopUsers       ShopUser[]
  moduleOverrides ShopModuleOverride[]
  paymentClaims   PaymentClaim[]

  syncedItems                 SyncedItem[]
  syncedCustomers             SyncedCustomer[]
  syncedInvoices              SyncedInvoice[]
  syncedInventoryTransactions SyncedInventoryTransaction[]
  syncedPaymentTransactions   SyncedPaymentTransaction[]

  invitations Invitation[]
  auditLogs   AuditLog[]
}

// The real person identity for the phone app — introduced alongside the
// multi-user/multi-shop migration's Phase 1 (see the plan doc). Dormant in
// this phase: nothing in the current authentication flow reads or writes
// this table yet, and Shop.phone remains the login identity for now. Every
// User is linked to zero or more Shops via ShopUser (see ShopUser.userId).
model User {
  id        String     @id @default(uuid())
  phone     String     @unique
  name      String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  memberships     ShopUser[]
  invitationsSent Invitation[]
}

model Module {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  planModules   PlanModule[]
  shopOverrides ShopModuleOverride[]
  userAccess    ShopUserModuleAccess[]
}

model Plan {
  id           String       @id @default(uuid())
  name         String       @unique
  price        Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle @default(MONTHLY)
  isActive     Boolean      @default(true)
  // Resource caps for this plan — null means unlimited. Read by
  // invoiceQuota/staffQuota's enforcement (and the matching usage-display
  // endpoints) via getEffectivePlan(), never hardcoded by plan name — keeps
  // every cap admin-configurable through the Plan row instead of a code
  // deploy.
  //
  // invoiceMonthlyLimit counts voice- and manually-created invoices
  // TOGETHER against one combined monthly quota — previously this was two
  // separate fields (a lifetime voice cap and a monthly manual cap); both
  // are gone, replaced by this single field, because the business rule
  // itself changed to "50 total invoices/month" rather than two
  // independently-tracked caps.
  invoiceMonthlyLimit Int?
  staffLimit          Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  modules       PlanModule[]
  subscriptions Subscription[]
  paymentClaims PaymentClaim[]
}

model PlanModule {
  id       String @id @default(uuid())
  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
}

model ShopModuleOverride {
  id       String  @id @default(uuid())
  shopId   String
  moduleId String
  enabled  Boolean

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([shopId, moduleId])
}

model Subscription {
  id        String             @id @default(uuid())
  shopId    String
  planId    String
  status    SubscriptionStatus @default(TRIAL)
  startDate DateTime           @default(now())
  endDate   DateTime?
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

// A shopkeeper's claim to have paid for a plan via UPI. UPI has no server-
// verifiable webhook for a plain VPA (no payment gateway/PSP is in play
// here) — so the client can only ever *claim* a payment happened; this
// model exists specifically so a claim never activates a subscription by
// itself. An admin reviews the claim (matching it against the actual UPI
// credit in their own bank/UPI app) and confirms or rejects it — only that
// action, on the backend, ever changes what plan is active. `reference` is
// the idempotency key the phone generates client-side and embeds in the UPI
// transaction note, so a retried/duplicate submission for the same intended
// payment reuses the same claim instead of creating a second one.
model PaymentClaim {
  id          String             @id @default(uuid())
  shopId      String
  planId      String
  amount      Decimal            @db.Decimal(10, 2)
  reference   String             @unique
  status      PaymentClaimStatus @default(PENDING)
  note        String?
  createdAt   DateTime           @default(now())
  confirmedAt DateTime?
  // Free text (admin email) rather than a relation — keeps this model
  // simple and avoids a hard FK to AdminUser for what's just an audit trail.
  reviewedBy  String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

model ShopUser {
  id        String         @id @default(uuid())
  shopId    String
  // Nullable — existing (pre-multi-user) rows have none yet, and Phase 1's
  // backfill only links a userId where it can safely identify one (see
  // scripts/backfill-shop-owners.js). Becomes the real authorization key once
  // a later phase wires auth through membership instead of the legacy Shop
  // token — this column is dormant until then.
  userId    String?
  // Metadata only in this phase — not read by any authorization/auth code
  // path yet (see the matching note on ShopUserPermission below).
  status    ShopUserStatus @default(ACTIVE)
  removedAt DateTime?
  name      String         // kept as a denormalized display field — may
  phone     String         // diverge from the linked User's name/phone over time
  role      ShopUserRole   @default(CASHIER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  shop         Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id])
  moduleAccess ShopUserModuleAccess[]
  permissions  ShopUserPermission[]

  @@unique([shopId, phone])
  // Index only, not unique — userId is nullable and multiple existing rows
  // will legitimately have no userId at all until backfilled/linked. A
  // future phase adds @@unique([shopId, userId]) once every row is required
  // to have one.
  @@index([shopId, userId])
}

// Granular module.action permission overrides for a ShopUser (e.g.
// "customer.view", "bill.delete") — finer-grained than
// ShopUserModuleAccess's per-module view/edit toggle above. No rows are
// created for this in Phase 1; role-default resolution and enforcement
// belongs to the future authorization phase. This table only adds the place
// to store overrides once that logic exists.
model ShopUserPermission {
  id         String   @id @default(uuid())
  shopUserId String
  permission String
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shopUser ShopUser @relation(fields: [shopUserId], references: [id], onDelete: Cascade)

  @@unique([shopUserId, permission])
}

model ShopUserModuleAccess {
  id         String  @id @default(uuid())
  shopUserId String
  moduleId   String
  canView    Boolean @default(true)
  canEdit    Boolean @default(false)

  shopUser ShopUser @relation(fields: [shopUserId], references: [id], onDelete: Cascade)
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([shopUserId, moduleId])
}

// ── Two-way business-data mirror. Each top-level model is upserted on
// (shopId, localId), where localId is the record's local SQLite autoincrement
// id for phone-originated rows, or a negative id (see negativeLocalId.js) for
// admin-panel-originated rows — chosen so the two id spaces never collide,
// since admin-created records get pulled down onto the phone too.
// Push (phone → cloud, shop-sync's POST /sync) always wins on whatever
// fields it sends, EXCEPT deletedAt: push must never set it, so a phone sync
// can never accidentally resurrect an admin-deleted record (see shop-sync's
// field builders). Pull (cloud → phone, GET /sync/pull) treats deletedAt as
// an unconditional tombstone and every other field as most-recent-wins by
// comparing localUpdatedAt. ─────────────────────────────────────────────────

model SyncedItem {
  id               String    @id @default(uuid())
  shopId           String
  localId          Int
  name             String
  sku              String?
  barcode          String?
  category         String?
  costPrice        Float
  sellingPrice     Float
  // Printed maximum retail price — independent of sellingPrice (what the
  // shop actually charges, which can run below MRP). Nullable: no existing
  // item has ever recorded one, and there's no real value to invent for a
  // row created before this field existed.
  mrp              Float?
  gstRate          Float
  stockQuantity    Int
  reorderLevel     Int
  imagePath        String?
  imageUrl         String?
  // Free-text item description — nullable, no existing item has one.
  description      String?
  // 'PRODUCT' | 'SERVICE' — a service never carries stock; see
  // inventoryEnabled below for what billing actually gates on.
  itemType         String    @default("PRODUCT")
  // The real authority for whether billing validates/deducts stock for this
  // item — independent of itemType (see the matching note on the Flutter
  // Item model). Defaults true: every row that existed before this column
  // was a physical product tracked exactly like this.
  inventoryEnabled Boolean   @default(true)
  aliases          String[]  @default([])
  // The item's full multi-image gallery — [{imageUrl, sortOrder, isPrimary}],
  // mirroring the phone's item_images table. Only imageUrl travels (never a
  // local file path, meaningless off-device); the phone matches pulled URLs
  // back to its own cached files by URL. See itemFields() in
  // shop-sync.service.js for why push never overwrites this with an empty
  // array from a phone that hasn't uploaded yet.
  images           Json      @default("[]")
  isActive         Boolean
  // Independent from isActive (an existing, separate status toggle already
  // exposed in the admin panel) — set only by an admin-panel delete, and
  // read only by the phone's pull-sync to know a item was removed.
  deletedAt        DateTime?
  localCreatedAt   DateTime
  localUpdatedAt   DateTime
  syncedAt         DateTime  @default(now())
  // Plain id, no FK relation — same convention as PaymentClaim.reviewedBy,
  // since this is a sync-mirrored row keyed by (shopId, localId), not one
  // Prisma manages relationally. Populated on create only (see syncData's
  // attribution()); historical rows from before that existed stay NULL —
  // never invented.
  createdByUserId  String?
  // Populated on update only — the inverse of createdByUserId, applied via
  // buildFields (the path upsertBatch's update() call uses) rather than
  // buildCreateOnlyFields.
  updatedByUserId  String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, localId])
}

model SyncedCustomer {
  id               String    @id @default(uuid())
  shopId           String
  localId          Int
  name             String
  phone            String?
  email            String?
  address          String?
  totalPurchases   Float
  totalBills       Int
  totalOutstanding Float
  advanceBalance   Float
  lastVisit        DateTime?
  imageUrl         String?
  deletedAt        DateTime?
  localCreatedAt   DateTime
  localUpdatedAt   DateTime
  syncedAt         DateTime  @default(now())
  // See the matching note on SyncedItem.createdByUserId.
  createdByUserId  String?
  updatedByUserId  String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, localId])
}

model SyncedInvoice {
  id              String    @id @default(uuid())
  shopId          String
  localId         Int
  invoiceNumber   String
  localCustomerId Int?
  customerName    String
  subtotal        Float
  discountType    String
  discountValue   Float
  discountAmount  Float
  gstAmount       Float
  grandTotal      Float
  receivedAmount  Float
  pendingAmount   Float
  paymentMode     String
  status          String
  notes           String?
  // Whether this invoice was created via voice billing — purely
  // informational/analytics now. A plan's invoiceMonthlyLimit (see Plan
  // model) counts voice and manually-created invoices together, so this
  // field no longer drives quota enforcement by itself (see
  // invoiceQuota.js's countInvoicesThisMonth, which ignores it).
  isVoiceCreated  Boolean   @default(false)
  deletedAt       DateTime?
  localCreatedAt  DateTime
  localUpdatedAt  DateTime
  syncedAt        DateTime  @default(now())
  // See the matching note on SyncedItem.createdByUserId.
  createdByUserId String?
  updatedByUserId String?

  shop  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items SyncedInvoiceItem[]

  @@unique([shopId, localId])
}

model SyncedInvoiceItem {
  id           String @id @default(uuid())
  invoiceId    String
  localId      Int
  localItemId  Int
  itemName     String
  // Snapshotted at sale time — see the matching note on Flutter's
  // InvoiceItem.itemType. Defaults 'PRODUCT': every line synced before this
  // column existed really was a physical product.
  itemType     String @default("PRODUCT")
  quantity     Int
  sellingPrice Float
  gstRate      Float
  gstAmount    Float
  lineTotal    Float

  invoice SyncedInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, localId])
}

model SyncedInventoryTransaction {
  id             String   @id @default(uuid())
  shopId         String
  localId        Int
  localItemId    Int
  localInvoiceId Int?
  type           String
  reason         String?
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  notes          String?
  localCreatedAt DateTime
  syncedAt       DateTime @default(now())
  // See the matching note on SyncedItem.createdByUserId.
  createdByUserId String?
  updatedByUserId String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, localId])
}

model SyncedPaymentTransaction {
  id              String    @id @default(uuid())
  shopId          String
  localId         Int
  localCustomerId Int
  localInvoiceId  Int?
  type            String
  amount          Float
  paymentMode     String
  notes           String?
  deletedAt       DateTime?
  localCreatedAt  DateTime
  // Nullable + backfilled (existing rows never had an edit timestamp before
  // two-way sync) — needed so admin edits/deletes to a payment are visible
  // to the phone's "changed since" pull query, same as every other entity.
  localUpdatedAt  DateTime?
  syncedAt        DateTime  @default(now())
  // See the matching note on SyncedItem.createdByUserId.
  createdByUserId String?
  updatedByUserId String?
  // The customer's totalOutstanding/advanceBalance immediately before this
  // transaction, captured once at insert time by the phone's
  // PaymentTransactionRepository.insert() (the single choke point every
  // payment/ledger mutation already goes through). Nullable — an older app
  // build that never sends these simply can't be checked for a financial
  // conflict, never treated as a false-positive mismatch. See syncData()'s
  // financial-conflict detection.
  customerOutstandingBefore Float?
  customerAdvanceBefore     Float?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, localId])
}

// A phone-number invitation for a person to join a Shop with a given role.
// No unique constraint on (shopId, invitedPhone): a revoked/expired
// invitation must be re-sendable, so "no duplicate *pending* invite" is a
// future service-layer check, not a DB constraint. Dormant in Phase 1 — no
// route creates or reads these yet.
model Invitation {
  id              String           @id @default(uuid())
  shopId          String
  invitedPhone    String
  role            ShopUserRole     @default(CASHIER)
  invitedByUserId String?
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  acceptedAt      DateTime?

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invitedBy User? @relation(fields: [invitedByUserId], references: [id])

  @@index([shopId, invitedPhone, status])
}

// Table only in Phase 1 — nothing writes to this yet; that's a future
// authorization/audit phase. shopId/userId here must always be server-
// derived when writes begin, never trusted from the client.
model AuditLog {
  id         String   @id @default(uuid())
  shopId     String
  userId     String?
  action     String
  module     String?
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([shopId, entityType, entityId])
}

// Server-side error capture — errorMiddleware writes here for every 5xx so
// a hard-to-reproduce production failure (works fine when reproduced from a
// dev machine, fails on a real device) can be inspected directly via the
// database instead of needing live access to Render's own log stream.
// Deliberately no relation to Shop: the shop/request context might itself
// be the thing that's broken, and this must never fail to write because of it.
model ErrorLog {
  id          String   @id @default(uuid())
  method      String
  path        String
  statusCode  Int
  message     String
  stack       String?
  shopId      String?
  bodyPreview String?
  createdAt   DateTime @default(now())
}
