# Neon PostgreSQL connection string (get this from your Neon project dashboard)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Server
PORT=4000

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Shop (phone app) tokens — kept long-lived since there's no refresh-token
# flow and re-auth requires a fresh SMS OTP.
SHOP_JWT_EXPIRES_IN="180d"

# Seeded superadmin (used by prisma/seed.js)
ADMIN_SEED_NAME="Super Admin"
ADMIN_SEED_EMAIL="admin@vaani.app"
ADMIN_SEED_PASSWORD="change-this-password"

# Voice billing — proxies the LLM call server-side so the key never ships in the app
GROQ_API_KEY="gsk_..."

# Real SMS OTP delivery (https://ninzasms.in.net)
NINZA_SMS_API_KEY="change-this"
NINZA_SMS_SENDER_ID="change-this"

# Comma-separated browser origins allowed to call the API (admin panel, shop portal)
ALLOWED_ORIGINS="http://localhost:5173"

# Cloudinary — admin-panel image management (upload/replace/delete product
# photos and shop logos). Unlike the phone app (which uploads straight to
# Cloudinary via an unsigned preset and never needs these), the backend
# performs signed operations, so the API key/secret live here, never client-side.
# Dashboard home page shows Cloud name; API Key/Secret are under Settings > API Keys.
CLOUDINARY_CLOUD_NAME="change-this"
CLOUDINARY_API_KEY="change-this"
CLOUDINARY_API_SECRET="change-this"
